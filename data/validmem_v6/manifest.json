  "dataset_id": "validmem_v5",
  "task": "一个冻结旧记忆库 + 独立新记忆写入;每条写入需从旧库检索出可能冲突的旧记忆。冲突 = 同一通道 + 同一事项 + 取值不同。",
  "source": {
    "dataset": "ValidMem",
    "url": "https://huggingface.co/datasets/Zhou11Alex/ValidMem",
    "citation": "Validity Is Not Visibility: A Lifecycle FSM for Agent Memory (EMNLP 2026)",
    "case_partition": [
      "A"
    ],
    "memories_file_sha256": "46627076c4170070ef33aa2c036ade07fe83a827658c0e0a2e2b3602665ac521",
