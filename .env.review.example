# V1 synthetic candidate review configuration. Use --review-env .env.review.
# V2 inheritance is offline and does not load this configuration or call models.
# The server's .env.review is private and ignored by Git.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
LLM_TEMPERATURE=0
# Leave blank if the replacement service does not support reasoning_effort.
LLM_REASONING_EFFORT=
API_TIMEOUT_SECONDS=240
API_MAX_RETRIES=4
API_RATE_LIMIT_BACKOFF=30
