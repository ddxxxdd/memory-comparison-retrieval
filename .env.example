# 两组服务分别配置；均使用 OpenAI 兼容协议。
# BASE_URL 填服务前缀（例如 https://your-provider.example/v1）；
# 也可填完整的 /chat/completions 或 /embeddings 地址。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 支持 JSON mode 的服务设为 true；不支持时改为 false，程序仍校验 JSON。
LLM_JSON_MODE=true
# 不支持 temperature 参数的服务留空即可。
LLM_TEMPERATURE=0
API_TIMEOUT_SECONDS=120
API_MAX_RETRIES=5
API_RATE_LIMIT_BACKOFF=8
EMBEDDING_BATCH_SIZE=32

# 主方法粗筛与细筛固定使用余弦阈值 0.7，不通过环境变量调整。
# top-k 诊断方法的默认候选预算：先取 50 条旧记录，再返回 10 条。
COARSE_K=50
FINAL_K=10

# 路径相对于项目根目录。缓存包含输入和模型输出，不包含 API Key。
CACHE_PATH=artifacts/api_cache.sqlite3
